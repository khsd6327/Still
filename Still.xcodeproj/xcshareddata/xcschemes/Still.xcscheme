            <ActionContent
               title = "Install Still in Applications"
               scriptText = "set -eu&#10;&#10;if [ &quot;${CONFIGURATION:-}&quot; != &quot;Debug&quot; ] || [ &quot;${ACTION:-}&quot; != &quot;build&quot; ] || [ &quot;${CODE_SIGNING_ALLOWED:-YES}&quot; = &quot;NO&quot; ]; then&#10;  exit 0&#10;fi&#10;&#10;source_app=&quot;${TARGET_BUILD_DIR}/${FULL_PRODUCT_NAME}&quot;&#10;destination_app=&quot;/Applications/${FULL_PRODUCT_NAME}&quot;&#10;install_id=&quot;${PPID}.$RANDOM&quot;&#10;staging_app=&quot;/Applications/.${FULL_PRODUCT_NAME}.installing.${install_id}&quot;&#10;rollback_app=&quot;/Applications/.${FULL_PRODUCT_NAME}.rollback.${install_id}&quot;&#10;&#10;if [ ! -d &quot;${source_app}&quot; ]; then&#10;  echo &quot;error: Built app was not found at ${source_app}&quot;&#10;  exit 1&#10;fi&#10;&#10;cleanup() {&#10;  if [ -e &quot;${staging_app}&quot; ]; then /bin/rm -rf &quot;${staging_app}&quot;; fi&#10;}&#10;trap cleanup EXIT HUP INT TERM&#10;&#10;/usr/bin/ditto &quot;${source_app}&quot; &quot;${staging_app}&quot;&#10;/usr/bin/codesign --verify --deep --strict &quot;${staging_app}&quot;&#10;if [ -e &quot;${destination_app}&quot; ]; then&#10;  /bin/mv &quot;${destination_app}&quot; &quot;${rollback_app}&quot;&#10;fi&#10;if ! /bin/mv &quot;${staging_app}&quot; &quot;${destination_app}&quot;; then&#10;  if [ -e &quot;${rollback_app}&quot; ]; then /bin/mv &quot;${rollback_app}&quot; &quot;${destination_app}&quot;; fi&#10;  exit 1&#10;fi&#10;if [ -e &quot;${rollback_app}&quot; ]; then /bin/rm -rf &quot;${rollback_app}&quot;; fi&#10;/usr/bin/touch &quot;${destination_app}&quot;&#10;trap - EXIT HUP INT TERM&#10;echo &quot;Installed ${destination_app}&quot;&#10;">
               <EnvironmentBuildable>
