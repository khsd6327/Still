+/* Versioned, layout-independent bridge for open-source Metal translation
+ * layers. Do not expose struct macdrv_win_data outside winemac.drv. */
+struct still_metal_view_bridge
+{
+    macdrv_metal_view metal_view;
+    macdrv_view owned_host_view;
+};
+
+__attribute__((visibility("default"))) macdrv_metal_view
+still_macdrv_create_metal_view_from_hwnd_v1(HWND hwnd, macdrv_metal_device device,
+                                            macdrv_metal_layer *layer)
+{
+    struct still_metal_view_bridge *bridge;
+    struct macdrv_win_data *data;
+    macdrv_view host_view = NULL;
+    macdrv_window cocoa_window = NULL;
+    BOOL retained_host_view = FALSE;
+    RECT rect;
+    HWND root;
+
+    if (layer) *layer = NULL;
+    if (!(bridge = calloc(1, sizeof(*bridge)))) return NULL;
+    if (!(data = get_win_data(hwnd)))
+    {
+        root = NtUserGetAncestor(hwnd, GA_ROOT);
+        if (!root || root == hwnd || !(data = get_win_data(root))) goto failed;
+    }
+
+    if (data->client_view)
+    {
+        host_view = macdrv_retain_view(data->client_view);
+        retained_host_view = TRUE;
+    }
+    else if (data->cocoa_window)
+        cocoa_window = macdrv_retain_window(data->cocoa_window);
+    release_win_data(data);
+
+    /* Never enter the AppKit main-thread bridge while holding win_data_mutex.
+     * The main thread can concurrently need that mutex while the render thread
+     * waits in OnMainThread(), which otherwise deadlocks after the first frame. */
+    if (!host_view && cocoa_window)
+    {
+        if (!NtUserGetClientRect(hwnd, &rect, NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI))) goto failed;
+        host_view = macdrv_create_view(cgrect_from_rect(rect));
+        if (!host_view) goto failed;
+        macdrv_set_view_superview(host_view, NULL, cocoa_window, NULL, NULL);
+        macdrv_set_view_hidden(host_view, FALSE);
+        bridge->owned_host_view = host_view;
+    }
+    if (!host_view) goto failed;
+
+    bridge->metal_view = macdrv_view_create_metal_view(host_view, device);
+    if (bridge->metal_view && layer)
+        *layer = macdrv_view_get_metal_layer(bridge->metal_view);
+    if (retained_host_view)
+    {
+        macdrv_release_view(host_view);
+        retained_host_view = FALSE;
+    }
+    if (cocoa_window)
+    {
+        macdrv_release_window(cocoa_window);
+        cocoa_window = NULL;
+    }
+    if (!bridge->metal_view || (layer && !*layer)) goto failed;
+    return (macdrv_metal_view)bridge;
+
+failed:
+    if (retained_host_view) macdrv_release_view(host_view);
+    if (cocoa_window) macdrv_release_window(cocoa_window);
+    if (bridge->metal_view) macdrv_view_release_metal_view(bridge->metal_view);
+    if (bridge->owned_host_view) macdrv_dispose_view(bridge->owned_host_view);
+    free(bridge);
+    return NULL;
+}
+
+__attribute__((visibility("default"))) void
+still_macdrv_release_metal_view_v1(macdrv_metal_view view)
+{
+    struct still_metal_view_bridge *bridge = (struct still_metal_view_bridge *)view;
+
+    if (!bridge) return;
+    if (bridge->metal_view) macdrv_view_release_metal_view(bridge->metal_view);
+    if (bridge->owned_host_view) macdrv_dispose_view(bridge->owned_host_view);
+    free(bridge);
+}
